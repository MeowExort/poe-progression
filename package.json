{
  "name": "poe-progression",
  "version": "0.4.4",
  "description": "SSF progression planner and tracker for Path of Exile with an in-game overlay",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^5.12.1"
  },
  "build": {
    "appId": "local.poe-progression",
    "productName": "PoE Progression",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "MeowExort",
        "repo": "poe-progression"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "artifactName": "PoE-Progression-Setup-${version}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MeowExort/poe-progression.git"
  },
  "author": "MeowExort"
}
