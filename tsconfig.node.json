{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "resolveJsonModule": true,
    "paths": { "@shared/*": ["./src/shared/*"], "@core/*": ["./src/core/*"], "@data/*": ["./data/*"] }
  },
  "include": ["electron.vite.config.ts", "vitest.config.ts", "src/main/**/*", "src/core/**/*", "src/preload/**/*", "src/shared/**/*", "test/**/*"]
}
